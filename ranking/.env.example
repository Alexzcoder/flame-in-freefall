# Copy this file to .env in the REPO ROOT (flame-in-freefall/.env). .env is git-ignored, never commit it.
#   cp ranking/.env.example .env
# Fill in ONE key. With both set, "auto" uses DeepSeek.

DEEPSEEK_API_KEY=your-deepseek-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional
RANKING_LLM_PROVIDER=auto
# RANKING_LLM_MODEL=deepseek-flash
